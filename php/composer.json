{
    "name": "codingduck/dss-server-client",
    "description": "Laravel client for dss-server, the HTTP sidecar of dss-native. Copied into applications (docs/server.md); this file only runs its tests.",
    "type": "library",
    "license": "LGPL-2.1-or-later",
    "require": {
        "php": ">=8.1",
        "ext-mbstring": "*",
        "guzzlehttp/guzzle": "^7.2",
        "guzzlehttp/psr7": "^2.0",
        "illuminate/http": "^10.0 || ^11.0 || ^12.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.5"
    },
    "autoload": {
        "psr-4": {
            "App\\Services\\Dss\\": ""
        },
        "exclude-from-classmap": [
            "tests/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Services\\Dss\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": "for f in *.php tests/*.php; do php -l \"$f\" || exit 1; done",
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
